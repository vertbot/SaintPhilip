---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { bulletins, formatDate } from '../lib/bulletins';

const [latest, ...past] = bulletins;
---
<Base title="Bulletins" description="Read this week's parish bulletin and past issues.">
  <PageHero title="Bulletins" intro="The weekly bulletin has Mass intentions, parish announcements and upcoming events." />
  <section class="section">
    <div class="wrap stack">
      {latest ? (
        <div class="latest">
          <div>
            <span class="eyebrow">This week</span>
            <h2>{formatDate(latest.date)}</h2>
          </div>
          <a class="btn btn--primary" href={latest.file}>Read the bulletin (PDF)</a>
        </div>
      ) : (
        <p>This week's bulletin will be posted soon.</p>
      )}

      {past.length > 0 && (
        <div>
          <h3>Past bulletins</h3>
          <ul class="list">
            {past.map((b) => (
              <li><a href={b.file}>{formatDate(b.date)}</a><span>PDF</span></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .stack { display: flex; flex-direction: column; gap: 40px; max-width: 760px; }
  .latest { background: var(--tint); border-radius: 18px; padding: 32px; display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; align-items: center; }
  .latest h2 { font-size: 32px; margin-top: 6px; }
  h3 { font-size: 24px; margin-bottom: 12px; }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 4px; border-bottom: 1px solid var(--line); }
  .list a { font-weight: 600; text-decoration: none; }
  .list span { color: var(--muted); font-size: 14px; }
</style>
