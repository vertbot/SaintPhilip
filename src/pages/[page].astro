---
// Simple text pages (About, Parish Life, Learn About the Faith, New Here, Give).
// Their text lives in src/content/pages and is editable at /admin/.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import settings from '../data/settings.json';

export async function getStaticPaths() {
  const modules = import.meta.glob<any>('../content/pages/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => ({
    params: { page: path.split('/').pop()!.replace(/\.md$/, '') },
    props: { mod },
  }));
}

const { page } = Astro.params;
const { mod } = Astro.props;
const { Content, frontmatter } = mod;
---
<Base title={frontmatter.title} description={frontmatter.intro}>
  <PageHero title={frontmatter.title} intro={frontmatter.intro} />
  <section class="section">
    <div class="wrap layout">
      <article class="prose"><Content /></article>
      {page === 'about' && (
        <aside class="side">
          <div class="side__card">
            <span class="eyebrow">Our mission</span>
            <p class="side__quote">“{settings.mission}”</p>
          </div>
          <div class="side__card">
            <span class="eyebrow">Parish staff</span>
            <ul class="side__list">
              {settings.staff.map((s) => <li><strong>{s.name}</strong><br>{s.role}</li>)}
            </ul>
          </div>
        </aside>
      )}
      {frontmatter.groups?.length > 0 && (
        <div class="groups">
          {frontmatter.groups.map((g: { name: string; photo?: string; description?: string }) => (
            <article class="group">
              {g.photo
                ? <img class="group__photo" src={g.photo} alt={g.name} loading="lazy" />
                : <div class="photo-placeholder group__photo">[PHOTO: {g.name}]</div>}
              <div class="group__body">
                <h2>{g.name}</h2>
                {g.description
                  ? <p>{g.description}</p>
                  : <p><span class="placeholder-text">[ADD: when and where it meets, and who to contact]</span></p>}
              </div>
            </article>
          ))}
        </div>
      )}
      {page === 'give' && settings.givingUrl && (
        <aside class="side"><a class="btn btn--gold" href={settings.givingUrl}>Give online</a></aside>
      )}
    </div>
  </section>
</Base>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .layout .prose { flex: 999 1 560px; min-width: 0; }
  .groups { flex: 1 1 100%; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .group { background: var(--tint); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
  .group__photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0; }
  .group__body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px; }
  .group__body h2 { font-size: 24px; }
  .group__body p { margin: 0; color: var(--body-ink); }
  .side { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .side__card { background: var(--tint); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .side__quote { margin: 0; font-family: var(--display); font-size: 20px; line-height: 1.45; }
  .side__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; color: var(--body-ink); }
  .side__list strong { color: var(--navy); }
</style>
