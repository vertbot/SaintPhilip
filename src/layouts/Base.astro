---
import '../styles/global.css';
import settings from '../data/settings.json';
import { bannerAnnouncements } from '../lib/announcements';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} | ${settings.parishName}` : `${settings.parishName} Catholic Church, Ashford CT`;
const metaDescription = description ?? `Mass times, bulletins and parish life at ${settings.parishName} Catholic Church in Ashford, Connecticut.`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/about', label: 'About Us' },
  { href: '/mass-and-sacraments', label: 'Mass & Sacraments' },
  { href: '/parish-life', label: 'Parish Life' },
  { href: '/learn-about-the-faith', label: 'Learn About the Faith' },
  { href: '/bulletins', label: 'Bulletins' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Netlify Identity: lets staff accept their invite email and set a password from any page. -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:wght@500;600&family=Figtree:wght@400;500;600;700&display=swap">
</head>
<body>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <a class="skip" href="#main">Skip to content</a>

  {bannerAnnouncements.map((a) => (
    <div class="alert" data-show-from={a.showFrom} data-show-until={a.showUntil}>
      <div class="wrap alert__inner">
        <strong>{a.title}</strong>
        {a.details && <span>{a.details}</span>}
        {a.link && <a href={a.link}>{a.linkLabel}</a>}
      </div>
    </div>
  ))}

  <div class="topbar">
    <div class="wrap topbar__inner">
      <span>{settings.address}, Ashford, CT · <a href={`tel:${settings.phone}`}>{settings.phone}</a></span>
      <div class="topbar__links">
        <a href="/bulletins">This week's bulletin</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>

  <header class="header">
    <div class="wrap header__inner">
      <a class="brand" href="/">
        <img class="brand__logo" src="/images/logo.svg" alt="" width="40" height="56">
        <span class="brand__text">
          <span class="brand__name">{settings.parishName}</span>
          <span class="brand__tag">{settings.tagline}</span>
        </span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        Menu
      </button>
      <nav aria-label="Main" class="nav" id="site-nav">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="btn btn--primary nav__give" href="/give">Give</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer" id="contact-footer">
    <div class="wrap footer__grid">
      <div class="footer__col">
        <span class="footer__name">{settings.parishName}</span>
        <span>{settings.address}</span>
        <span>{settings.cityStateZip}</span>
        <a class="footer__accent" href={settings.mapUrl}>Get directions</a>
      </div>
      <div class="footer__col">
        <span class="footer__head">Parish office</span>
        <a href={`tel:${settings.phone}`}>{settings.phone}</a>
        {settings.email
          ? <a href={`mailto:${settings.email}`}>{settings.email}</a>
          : <span class="placeholder-text">[PARISH EMAIL]</span>}
        <span>{settings.officeHours}</span>
      </div>
      <div class="footer__col">
        <span class="footer__head">Parish staff</span>
        {settings.staff.map((s) => <span>{s.name}, {s.role}</span>)}
      </div>
      <div class="footer__col">
        <span class="footer__head">Quick links</span>
        <a href="/mass-and-sacraments">Mass times</a>
        <a href="/bulletins">Bulletins</a>
        <a href="/new-here">Register</a>
        <a href="/give">Give</a>
        <a href="/admin/">Staff login</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    // Hide announcements outside their dates, so a notice disappears the day after it ends
    // even if the site hasn't been rebuilt since.
    (function () {
      var d = new Date();
      var today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      document.querySelectorAll('[data-show-until]').forEach(function (el) {
        var from = el.getAttribute('data-show-from') || '';
        var until = el.getAttribute('data-show-until') || '';
        if ((from && today < from) || (until && today > until)) el.hidden = true;
      });
      document.querySelectorAll('[data-announcements]').forEach(function (sec) {
        if (!sec.querySelector('[data-show-until]:not([hidden])')) sec.hidden = true;
      });
    })();
  </script>

  <script is:inline>
    // After a staff member accepts an invite or signs in, send them to the editor.
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', (user) => {
        if (!user) {
          window.netlifyIdentity.on('login', () => { document.location.href = '/admin/'; });
        }
      });
    }
  </script>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.getElementById('site-nav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 16px; z-index: 10; background: #fff; padding: 8px 12px; }

  .alert { background: var(--gold-bright); color: var(--navy); font-size: 15px; }
  .alert__inner { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; justify-content: center; text-align: center; padding-block: 10px; }
  .alert a { color: var(--navy); font-weight: 700; }
  [hidden] { display: none !important; }

  .topbar { background: var(--navy); color: #dfe7f2; font-size: 14px; }
  .topbar__inner { display: flex; flex-wrap: wrap; gap: 6px 24px; justify-content: space-between; align-items: center; padding-block: 8px; }
  .topbar a { color: #ffffff; text-decoration: none; font-weight: 600; }
  .topbar__links { display: flex; gap: 20px; flex-wrap: wrap; }

  .header { border-bottom: 1px solid var(--line); background: #ffffff; }
  .header__inner { display: flex; flex-wrap: wrap; gap: 16px 32px; justify-content: space-between; align-items: center; padding-block: 16px; }

  .brand { display: flex; gap: 14px; align-items: center; text-decoration: none; color: var(--navy); }
  .brand:hover { color: var(--navy); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand__name { font-family: var(--display); font-weight: 600; font-size: 23px; }
  .brand__tag { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

  .menu-toggle { display: none; }
  .nav { display: flex; flex-wrap: wrap; gap: 6px 24px; align-items: center; font-weight: 600; font-size: 16px; }
  .nav a:not(.btn) { color: var(--navy); text-decoration: none; padding-block: 6px; border-bottom: 2px solid transparent; }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { border-bottom-color: var(--blue); }
  .nav__give { padding: 10px 20px; }

  /* Phones: the menu folds behind a Menu button. Without JavaScript it stays open. */
  @media (max-width: 980px) {
    .menu-toggle {
      display: flex; align-items: center; gap: 8px; cursor: pointer; font: inherit; font-weight: 700; color: var(--navy);
      background: #ffffff; padding: 10px 16px; border: 1px solid var(--line-strong); border-radius: 999px;
    }
    .nav { width: 100%; flex-direction: column; align-items: stretch; gap: 0; }
    :global(.js) .nav:not(.is-open) { display: none; }
    .nav a:not(.btn) { padding: 14px 4px; border-bottom: 1px solid var(--line); }
    .nav a[aria-current='page'] { color: var(--blue); }
    .nav__give { margin-top: 14px; text-align: center; }
  }

  .footer { background: var(--navy-deep); color: var(--footer-ink); font-size: 15px; }
  .footer__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; padding-block: 48px; }
  .footer__col { display: flex; flex-direction: column; gap: 6px; }
  .footer__col a { color: var(--footer-ink); text-decoration: none; }
  .footer__col a:hover { color: #ffffff; text-decoration: underline; }
  .footer__name { color: #ffffff; font-family: var(--display); font-size: 20px; font-weight: 600; }
  .footer__head { color: #ffffff; font-weight: 700; }
  .footer .footer__accent { color: var(--gold-bright); font-weight: 600; }
</style>
